{
  "name": "aconcagua-stone-sentinel",
  "type": "module",
  "private": true,
  "version": "1.5.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check:lock-version": "node scripts/check-lock-version.js",
    "validate:links": "node scripts/check-markdown-links.js --include-temp",
    "simulate": "node scripts/monte-carlo-web-v1.js",
    "test": "npm run test:api && npm run test:webv1 && npm run test:web3d",
    "test:api": "node --test api/run.test.js",
    "test:webv1": "node scripts/run-webv1-tests.js",
    "test:web3d": "node --test prototype/web-3d/tests/route.test.js prototype/web-3d/tests/sim.test.js prototype/web-3d/tests/surface.test.js",
    "test:contracts": "node --test prototype/web-v1/tests/model-contract.test.js prototype/web-v1/tests/parity/repo-truth-parity.test.js prototype/web-v1/tests/parity/repo-truth-guarantees.test.js prototype/web-v1/tests/parity/dual-prototype-contract.test.js",
    "test:full": "npm run typecheck && npm run test:webv1 && pytest prototype/mra-v0/test_simulator.py -v",
    "smoke:release": "node scripts/release-smoke-vercel.js",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc -p tsconfig.json",
    "validate:json": "node scripts/validate-json.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
