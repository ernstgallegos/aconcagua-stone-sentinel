{
  "name": "aconcagua-stone-sentinel",
  "type": "module",
  "private": true,
  "version": "1.4.6",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check:lock-version": "node scripts/check-lock-version.js",
    "simulate": "node scripts/monte-carlo-web-v1.js",
    "test": "npm run test:api && npm run test:webv1",
    "test:api": "node --test api/run.test.js",
    "test:webv1": "node scripts/run-webv1-tests.js",
    "test:full": "npm run typecheck && npm run test:webv1 && pytest prototype/mra-v0/test_simulator.py -v",
    "smoke:release": "node scripts/release-smoke-vercel.js",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc -p tsconfig.json",
    "validate:json": "node scripts/validate-json.js"
  }
}
