{
  "contractVersion": "1.1.0",
  "scope": "Canonical model concepts shared across prototype/mra-v0 and prototype/web-v1",
  "authoritativeArtifacts": {
    "outcomes": "data/outcomes.json (web-v1 active canonical source)",
    "webStateSemantics": "prototype/web-v1/engine/turn-resolution.js",
    "mraBaselineSemantics": "prototype/mra-v0/simulator.py (historical baseline only)",
    "mraRequiredStateShape": "prototype/mra-v0/scenarios/scenario.schema.json",
    "contextEvents": "data/context_events.json (seeded bounded environment-event contract for web-v1)"
  },
  "jsonSchemas": {
    "description": "JSON Schema (draft-07) files for all canonical data contracts. Used for IDE validation and formal contract documentation.",
    "characters": "data/contracts/characters.schema.json",
    "nodes": "data/contracts/nodes.schema.json",
    "actionModifiers": "data/contracts/action_modifiers.schema.json",
    "stageModifiers": "data/contracts/stage_modifiers.schema.json",
    "outcomes": "data/contracts/outcomes.schema.json",
    "scenarios": "data/contracts/scenarios.web-v1.schema.json",
    "contextEvents": "data/contracts/context_events.schema.json",
    "characterEvents": "data/contracts/character_events.schema.json"
  },
  "sharedContract": {
    "stateMetricsRequired": [
      "position",
      "weather_severity",
      "visibility",
      "terrain_load",
      "functional_capacity",
      "fatigue",
      "exposure",
      "water",
      "food"
    ],
    "turnSemantics": [
      "advance",
      "advance_slowly",
      "wait",
      "descend",
      "sleep",
      "shoot_photo"
    ],
    "contextualActions": {
      "shoot_photo": "Exclusive to Daniela De Rossi. Requires water > 0 and food > 0. Subject to cooldown and session cap."
    }
  },
  "outcomes": {
    "webV1Canonical": [
      "Summit and Safe Return",
      "High Point Return",
      "Strategic Retreat",
      "Rescue",
      "Collapse (Fatigue)",
      "Collapse (Exposure)",
      "Resource Exhaustion",
      "Expedition Window Closed",
      "Permit Expired",
      "Fatality"
    ],
    "mraV0Legacy": [
      "summit",
      "retreated",
      "incapacitated",
      "deteriorated",
      "stabilized",
      "survived-marginal"
    ]
  },
  "intentionalDivergences": [
    {
      "concept": "Outcome taxonomy",
      "difference": "web-v1 uses player-facing canonical outcome labels, while mra-v0 keeps historical compressed classes.",
      "status": "intentional"
    },
    {
      "concept": "Altitude band vocabulary",
      "difference": "web-v1 stage/route abstraction differs from mra-v0 low/mid/high bands and does not require identical labels.",
      "status": "intentional"
    },
    {
      "concept": "Active mechanics",
      "difference": "web-v1 includes permit, decision-window, and character-specific systems that mra-v0 does not implement.",
      "status": "intentional"
    }
  ]
}
