# Vercel serverless API — runtime environment variables
# Copy to .env.local for local development. Never commit .env.local.

# Comma-separated list of exact allowed origins for CORS.
# If not set, falls back to a hardcoded development default in api/run.js.
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Distributed rate-limit backend (Upstash/Vercel KV REST API).
# Required on Vercel production deployments; when missing in Vercel env,
# api/run.js now fails closed with HTTP 503 instead of falling back to
# per-instance in-memory counters.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Rate limiting window in milliseconds (default: 60000 = 1 minute)
API_RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP per window (default: 30)
API_RATE_LIMIT_MAX=30
